# --- secretos y datos personales — NUNCA al repo (el histórico se publica al hacerlo público) ---
.env
# Cualquier variante del .env, con punto o sin él. El 2026-11-12 llegó del otro equipo un
# fichero `env2` —sin punto— que el `.env` de arriba NO cubría: estuvo a un `git add -A`
# de entrar al repo con las claves de Anthropic, Groq y ElevenLabs dentro, y el repo va a
# ser público. Ignorar el patrón y no el nombre exacto es lo único que evita el siguiente.
.env.*
env*
!.env.example
health-boost-*.json
keep.txt
# memoria de Jarvis: conversaciones privadas y lo que sabe de Hugo
jarvis.db

# --- regenerable ---
venv/
# Servicio TTS local (solo portátil): audio generado y cachés pesadas
dashboard/tts/muestras/*.wav
dashboard/tts/muestras/*.mp3
dashboard/frontend/public/muestras/*.wav
dashboard/frontend/public/muestras/*.mp3
*.pyc
dashboard/frontend/node_modules/
dashboard/frontend/dist/
# caché incremental de tsc: cambia en cada build y difiere entre máquinas
dashboard/frontend/tsconfig.tsbuildinfo
__pycache__/
*.pyc
entreno_join.csv
# log del backend: local de cada máquina y con las peticiones de Hugo dentro
logs/

# --- claude / editor / SO ---
.claude/
.DS_Store

# Comando local para reanudar la sesión de Claude Code (específico de cada máquina).
# Van los DOS nombres a propósito: cada equipo lo bautizó al revés que el otro, y el del
# portátil (`claude_sesion.txt`) llevaba desde el 09/09 sin estar ignorado de verdad. No
# llegó a subirse de milagro; un `git add -A` lo habría metido sin que saltara nada.
sesion_claude.txt
claude_sesion.txt
