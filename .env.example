# Plantilla de configuración. Copia este archivo a .env y rellena los valores.
# NO subas .env ni el JSON de service account al repositorio.

# Intervals.icu
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# Google
GOOGLE_SA_JSON=./health-boost-XXXXXX.json   # ruta al JSON del service account
SHEET_ID=                                     # ID de la hoja "Health_booster_data"
DRIVE_EXCEL_ID=                               # ID del Excel del plan en Drive

# Log de entreno
KEEP_TXT=./keep.txt

# Opcionales del pipeline (reintentos de Intervals si falta el HRV de ayer)
INTERVALS_REINTENTOS=3
INTERVALS_ESPERA_S=8

# Jarvis (Fase 2) — qué modelo responde en el chat: "ollama" o "anthropic".
# Cambiar esta variable intercambia el proveedor sin tocar nada más.
JARVIS_PROVEEDOR=ollama

# Modelo local (por defecto). Nada sale de la máquina y no cuesta dinero.
OLLAMA_URL=http://localhost:11434
# La RTX 3060 del Nitro 5 es la variante Laptop: 6 GB de VRAM, y el escritorio de
# Windows ya se come ~2 GB, así que quedan ~4 GB libres. Medido: qwen2.5:7b (5.1 GB)
# NO cabe → Ollama deja el ~18% en CPU y la latencia se dispara a 5-25s, inestable.
# qwen2.5:3b (2.2 GB) sí entra al 100% en la GPU → respuestas en ~3s, estables. Es
# más tonto (a veces se equivoca con números), pero cumple el objetivo de latencia.
# Con más VRAM, subir a 7b/8b da mejor calidad.
OLLAMA_MODELO=qwen2.5:3b

# API de Anthropic. Solo hace falta si JARVIS_PROVEEDOR=anthropic.
# OJO: con este proveedor las conversaciones salen de tu máquina.
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-sonnet-5

# --- Groq: el modelo rápido que escribe las muletillas (opcional) --------------
# Escribe la coletilla ("déjame que mire lo del hombro…") a medida para lo que Hugo acaba
# de decir, en vez de sacarla del bote de frases pregrabadas. Ver dashboard/backend/rapido.py.
#
# SIN ESTO NO SE ROMPE NADA: si falta la clave o el modelo, o si tarda más de
# GROQ_TIMEOUT_MS, se usan las pregrabadas de siempre.
#
# La clave sale de console.groq.com y empieza por gsk_. Ojo: Groq (con q) es la empresa de
# hardware de inferencia; Grok (con k) es el modelo de xAI, otra cosa.
GROQ_API_KEY=
# El identificador EXACTO de su lista de modelos, copiado del panel. No lleva valor por
# defecto a propósito: los catálogos cambian (retiraron varios en agosto de 2026) y un
# nombre viejo falla en silencio. Para elegirlo:
#   python scratchpad/elegir_modelo.py    (los cronometra con tu clave)
# Elegido: groq/compound-mini. Más lento (~1,5 s) que otros, pero es el que escribe como
# Jarvis, y hay 4,5 s de margen antes de que la muletilla haga falta. Aquí manda el TONO,
# no los milisegundos. Los descartados y por qué, en la §16 del HANDOFF: los gpt-oss
# razonan y devuelven texto VACÍO, y qwen3.6 escupe su <think> dentro de la respuesta.
GROQ_MODELO=
# Plazo duro en ms. Pasado, se tira de las pregrabadas: una muletilla tarde es el silencio
# MÁS la muletilla, o sea peor que no tenerla.
GROQ_TIMEOUT_MS=3000
# Solo si algún día se cambia de proveedor: habla API de OpenAI, así que vale cualquiera
# que la exponga.
GROQ_URL=https://api.groq.com/openai/v1
